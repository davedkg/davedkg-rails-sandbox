.card
  .card-header.d-flex.justify-content-between.align-items-center
    %b.fs-3 <%= plural_table_name.humanize.titleize %> 
    = link_to new_<%= singular_table_name %>_path, class: "btn btn-primary" do 
      %i.bi.bi-plus
      New <%= singular_table_name.titleize %>
  %table.table.table-striped.table-hover.mb-0
    %thead
      %tr
      <%- attributes.each do |attribute| -%>
        %th <%= attribute.name.humanize %>
      <%- end -%>
        %th &nbsp;
    %tbody
      - @<%= plural_table_name %>.each do |<%= singular_table_name %>|
        %tr
        <%- attributes.each do |attribute| -%>
          %td= <%= singular_table_name %>.<%= attribute.name %>
        <%- end -%>
          %td.text-end
            = link_to 'Show', <%= singular_table_name %>_path(<%= singular_table_name %>), class: "btn btn-sm btn-secondary"